RewriteEngine On

# Jika project berada di dalam sub-folder htdocs, baris ini otomatis menyesuaikan
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?/$1 [L,QSA]

# --- KEAMANAN FOLDER .GIT ---
RewriteRule ^(.*/)?\.git(/|$) - [F,L]

# --- KEAMANAN ASSETS & UPLOADS (Versi Fleksibel) ---
# Blokir file berbahaya di folder assets selain ekstensi asset standar
RewriteCond %{REQUEST_URI} ^.*/assets/ [NC]
RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot|otf|ico)$ [NC]
RewriteRule ^ - [F,L]

# Blokir file berbahaya di folder uploads selain ekstening file aman
RewriteCond %{REQUEST_URI} ^.*/uploads/ [NC]
RewriteCond %{REQUEST_URI} !\.(jpg|jpeg|png|gif|svg|webp|mp4|avi|mov|pdf|txt|doc|docx|xls|xlsx|zip|rar)$ [NC]
RewriteRule ^ - [F,L]

# --- KONFIGURASI PHP ---
<IfModule mod_php.c>
php_value post_max_size 400M
php_value upload_max_filesize 400M
</IfModule>